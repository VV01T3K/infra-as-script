# Credentials and generated files never go into Git...
/secrets/*
# ...except encrypted files, which need a YubiKey to open.
!/secrets/*.sops.yaml
/build/
/.venv/
/.collections/
# OpenTofu: downloaded providers and the previous state copy (the state itself is committed, encrypted).
/stages/3-guests/.terraform/
/stages/3-guests/terraform.tfstate.backup
/network/.terraform/
/network/terraform.tfstate.backup
