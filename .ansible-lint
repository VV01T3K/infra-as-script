# ansible-lint settings. Stages need a machine name; lint checks them as if for torus.
extra_vars:
  machine: torus
# Not Ansible files; .sops.yaml holds very long (post-quantum) recipients.
exclude_paths:
  - .sops.yaml
  - secrets/
# run_once is used on purpose (one API call or one secrets file for many hosts); this repo never uses
# the "free" strategy that the rule warns about.
skip_list:
  - run-once[task]
