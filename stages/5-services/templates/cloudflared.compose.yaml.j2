# The connector shares only its private ingress network with Caddy.
services:
  cloudflared:
    image: {{ service_secrets.cloudflared_image | to_json }}
    container_name: cloudflared
    command: [tunnel, --no-autoupdate, --metrics, "0.0.0.0:2000", run]
    environment:
      TUNNEL_TOKEN: {{ service_secrets.cloudflared_token | to_json }}
    restart: unless-stopped
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    networks:
      ingress:
        ipv4_address: 172.31.255.2
      outbound: {}

networks:
  ingress:
    external: true
    name: cloudflare_ingress
  outbound: {}
