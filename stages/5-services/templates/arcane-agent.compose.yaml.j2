# Managed by stage 5 (infra-as-script): Arcane agent in edge mode. It connects out to the manager
# over HTTPS (through Caddy, certificate checked), so this guest opens no port for it.
services:
  arcane-agent:
    image: ghcr.io/getarcaneapp/agent:{{ arcane_version }}
    container_name: arcane-agent
    environment:
      EDGE_AGENT: "true"
      AGENT_TOKEN: {{ service_secrets.arcane_agent_tokens[inventory_hostname] | to_json }}
      MANAGER_API_URL: https://{{ arcane_host }}
      EDGE_TRANSPORT: websocket
      TZ: {{ locale.timezone }}
    # The manager's name is fixed here, so the agent doesn't need our DNS (guests use the router's).
    extra_hosts:
      - "{{ arcane_host }}:{{ hostvars[groups.arcane_manager | first].address }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - data:/app/data
    cgroup: host
    restart: unless-stopped

volumes:
  data:
