# Managed by stage 5 (infra-as-script): the Arcane manager (dashboard + GitOps for the services).
# Reached only through Caddy: https://{{ arcane_host }} (browser and agents). Its own port is open
# only inside this guest, for stage 5's API calls.
services:
  arcane:
    image: ghcr.io/getarcaneapp/manager:{{ arcane_version }}
    container_name: arcane
    ports:
      - "127.0.0.1:3552:3552"
    environment:
      ENCRYPTION_KEY: {{ service_secrets.arcane_encryption_key | to_json }}
      # Lets stage 5 configure Arcane through its API (sent as the X-Api-Key header).
      ADMIN_STATIC_API_KEY: {{ service_secrets.arcane_api_key | to_json }}
      APP_URL: https://{{ arcane_host }}
      PROJECTS_DIRECTORY: /opt/arcane/projects
      # No usage heartbeat to checkin.getarcane.app.
      ANALYTICS_DISABLED: "true"
      TZ: {{ locale.timezone }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # Keep the LXC's LXCFS CPU view inside Docker (guest CPU count and usage).
      - /proc/cpuinfo:/proc/cpuinfo:ro
      - /proc/stat:/proc/stat:ro
      - data:/app/data
      - /opt/arcane/projects:/opt/arcane/projects
    # Lets Arcane recognise its own container.
    cgroup: host
    networks: [caddy]
    labels:
      caddy: "{{ arcane_host }}"
      caddy.reverse_proxy: "{{ '{{' }}upstreams 3552{{ '}}' }}"
    restart: unless-stopped

networks:
  caddy:
    external: true # created by Caddy's compose project

volumes:
  data:
