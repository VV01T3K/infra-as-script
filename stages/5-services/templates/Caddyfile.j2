# Managed by stage 5 (infra-as-script): Caddy's base settings. Routes come from Docker labels:
# a container on the network "caddy" with labels
#   caddy: <name>.{{ domain }}
#   caddy.reverse_proxy: "{{ '{{' }}upstreams <port>{{ '}}' }}"
# is served at https://<name>.{{ domain }}. Names under the wildcard below use its certificate
# (Caddy does that by itself): one certificate for all, and the public certificate logs show only
# *.{{ domain }}, not each name.
{
{% if caddy_tunnel_enabled | default(false) | bool %}
	servers {
		trusted_proxies static 172.31.255.2/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
{% endif %}
	# Let's Encrypt. A test run can use its staging server instead (untrusted certificates, but no risk
	# to the real rate limits): mise run services --tags proxy -e caddy_acme_staging=true
	acme_ca {{ 'https://acme-staging-v02.api.letsencrypt.org/directory' if caddy_acme_staging | default(false) | bool else 'https://acme-v02.api.letsencrypt.org/directory' }}
{% if caddy_security_enabled | default(false) | bool %}
	storage redis {
		address valkey:6379
		password {env.VALKEY_PASSWORD}
		db 4
		encryption_key {env.VALKEY_ENCRYPTION_KEY}
		compression true
	}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_API_KEY}
		ticker_interval 15s
		enable_hard_fails
	}
	order crowdsec first
{% endif %}
}

{% if caddy_security_enabled | default(false) | bool %}
(protected) {
	log {
		output stdout
{% if caddy_tunnel_enabled | default(false) | bool %}
		format filter {
			wrap json
			fields {
				request>headers>X-Api-Key delete
				request>headers>X-Cloudflare-Secret delete
			}
		}
{% else %}
		format json
{% endif %}
	}
	crowdsec
}

# docker-proxy merges these blocks with the upstreams supplied by container labels.
# This applies protection without restarting either application.
{{ arcane_host }} {
	import protected
}
{{ cliproxy_host }} {
	import protected
}
{% endif %}

# The wildcard certificate, through Cloudflare DNS (works for names that exist only inside the network).
# A name with no route of its own gets its connection closed.
{% for wildcard_domain in caddy_wildcard_domains | default([domain]) %}
*.{{ wildcard_domain }} {
{% if caddy_security_enabled | default(false) | bool %}
	import protected
{% endif %}
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	abort
}
{% endfor %}

# Routes to web UIs on other guests (pdm, omv), written at the end of stage 5. No file yet = only a warning.
import /etc/caddy/backends/*.caddy
