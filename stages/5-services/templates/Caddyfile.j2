# Managed by stage 5 (infra-as-script): Caddy's base settings. Routes come from Docker labels:
# a container on the network "caddy" with labels
#   caddy: <name>.{{ domain }}
#   caddy.reverse_proxy: "{{ '{{' }}upstreams <port>{{ '}}' }}"
# is served at https://<name>.{{ domain }}. Names under the wildcard below use its certificate
# (Caddy does that by itself): one certificate for all, and the public certificate logs show only
# *.{{ domain }}, not each name.
{
	# Let's Encrypt. A test run can use its staging server instead (untrusted certificates, but no risk
	# to the real rate limits): mise run services --tags proxy -e caddy_acme_staging=true
	acme_ca {{ 'https://acme-staging-v02.api.letsencrypt.org/directory' if caddy_acme_staging | default(false) | bool else 'https://acme-v02.api.letsencrypt.org/directory' }}
}

# The wildcard certificate, through Cloudflare DNS (works for names that exist only inside the network).
# A name with no route of its own gets its connection closed.
*.{{ domain }} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	abort
}

# Routes to web UIs on other guests (pdm, omv), written at the end of stage 5. No file yet = only a warning.
import /etc/caddy/backends/*.caddy
