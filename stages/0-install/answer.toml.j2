# Proxmox automated installer answer for {{ inventory_hostname }}.
# Stage 0 fills this in; the result is secrets/{{ inventory_hostname }}/installer/answer.toml.
# Reference: https://pve.proxmox.com/wiki/Automated_Installation
{% set net = networks[network] %}

[global]
keyboard = "{{ locale.keyboard }}"
country = "{{ locale.country }}"
timezone = "{{ locale.timezone }}"
fqdn = "{{ inventory_hostname }}.{{ domain }}"
mailto = "root@localhost"
root-password-hashed = "{{ installer_root_password_hash }}"
root-ssh-keys = ["{{ installer_public_key }}"]
# Switch off when done, not restart: some BIOSes (e.g. kestrel's) boot USB first,
# so a restart with the stick still in would start the installer again.
reboot-mode = "power-off"

[network]
source = "from-answer"
cidr = "{{ address }}/{{ net.subnet.split('/')[1] }}"
gateway = "{{ net.gateway }}"
dns = "{{ net.dns }}"
# Use only this machine's network card.
filter.ID_NET_NAME_MAC = "enx{{ mac | replace(':', '') }}"

[disk-setup]
filesystem = "{{ install.filesystem }}"
# Install only onto this exact disk. On any other machine nothing matches and the installer stops.
filter.ID_SERIAL_SHORT = "{{ install.disk_serial }}"
